{
  "info": {
    "name": "CareerPath API Collection",
    "description": "Postman Collection for CareerPath – Student Career & Placement Tracker REST APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login - Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@careerpath.edu\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login - Student",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rahul.sharma@careerpath.edu\",\n  \"password\": \"Student@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Register Student",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"anita.deshmukh@careerpath.edu\",\n  \"password\": \"Student@123\",\n  \"name\": \"Anita Deshmukh\",\n  \"department\": \"Computer Science and Engineering\",\n  \"cgpa\": 9.15,\n  \"graduationYear\": 2026,\n  \"phone\": \"+91 9898989898\",\n  \"resumeUrl\": \"https://example.com/resumes/anita.pdf\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Get Current User Profile (/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Student Operations",
      "item": [
        {
          "name": "Get Student Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/student/profile", "host": ["{{baseUrl}}"], "path": ["api", "student", "profile"] }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul Sharma\",\n  \"department\": \"Computer Science and Engineering\",\n  \"phone\": \"+91 9876543210\",\n  \"cgpa\": 8.90,\n  \"graduationYear\": 2026,\n  \"resumeUrl\": \"https://example.com/resumes/rahul-updated.pdf\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/student/profile", "host": ["{{baseUrl}}"], "path": ["api", "student", "profile"] }
          }
        },
        {
          "name": "Add Skill",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skillName\": \"Kubernetes\",\n  \"proficiency\": \"INTERMEDIATE\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/student/skills", "host": ["{{baseUrl}}"], "path": ["api", "student", "skills"] }
          }
        },
        {
          "name": "View Open Jobs (with Filters & Eligibility)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/student/jobs?page=0&size=10", "host": ["{{baseUrl}}"], "path": ["api", "student", "jobs"] }
          }
        },
        {
          "name": "Apply for Job",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/student/jobs/1/apply", "host": ["{{baseUrl}}"], "path": ["api", "student", "jobs", "1", "apply"] }
          }
        },
        {
          "name": "Get Application History & Timeline",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/student/applications", "host": ["{{baseUrl}}"], "path": ["api", "student", "applications"] }
          }
        }
      ]
    },
    {
      "name": "Admin Operations",
      "item": [
        {
          "name": "Dashboard Statistics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/dashboard/stats", "host": ["{{baseUrl}}"], "path": ["api", "admin", "dashboard", "stats"] }
          }
        },
        {
          "name": "List Students (Paginated & Search)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/students?page=0&size=10", "host": ["{{baseUrl}}"], "path": ["api", "admin", "students"] }
          }
        },
        {
          "name": "Create Company Partner",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"NVIDIA India\",\n  \"industry\": \"AI & Semiconductor\",\n  \"location\": \"Pune, Maharashtra\",\n  \"website\": \"https://nvidia.com\",\n  \"description\": \"Pioneer in GPU-accelerated computing\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/companies", "host": ["{{baseUrl}}"], "path": ["api", "admin", "companies"] }
          }
        },
        {
          "name": "Post Job Drive",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyId\": 1,\n  \"title\": \"AI Infrastructure Engineer\",\n  \"description\": \"Design CUDA accelerated pipelines\",\n  \"requiredSkills\": \"C++, Python, CUDA\",\n  \"minCgpa\": 8.5,\n  \"packageLpa\": 28.0,\n  \"location\": \"Pune\",\n  \"deadline\": \"2026-12-31T23:59:59\",\n  \"status\": \"OPEN\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/jobs", "host": ["{{baseUrl}}"], "path": ["api", "admin", "jobs"] }
          }
        },
        {
          "name": "Schedule Interview Round",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"interviewDate\": \"2026-10-25T14:30:00\",\n  \"mode\": \"ONLINE\",\n  \"roundName\": \"Technical Round 2 - System Architecture\",\n  \"locationOrLink\": \"https://meet.google.com/xyz-eval\",\n  \"feedback\": \"Candidate passed round 1 with high score\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/applications/1/interviews", "host": ["{{baseUrl}}"], "path": ["api", "admin", "applications", "1", "interviews"] }
          }
        },
        {
          "name": "Record Final Placement",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": 1,\n  \"companyId\": 1,\n  \"jobId\": 1,\n  \"packageLpa\": 24.5,\n  \"placedDate\": \"2026-10-10\",\n  \"joiningDate\": \"2026-07-01\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/placements", "host": ["{{baseUrl}}"], "path": ["api", "admin", "placements"] }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminToken", "value": "" },
    { "key": "studentToken", "value": "" }
  ]
}
